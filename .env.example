POSTGRES_DB=transparencia
POSTGRES_USER=transparencia
POSTGRES_PASSWORD=troque-esta-senha

# Porta do Postgres do container no host. Evite 5432 se já houver PostgreSQL instalado na máquina.
DB_PORT=15432
HTTP_PORT=8080

# Memória do PostgreSQL (~25% e ~75% da RAM do servidor)
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB

# CPF/CNPJ e nome do proprietário são dados pessoais (LGPD).
# false = API devolve mascarado. Nunca vão nos vector tiles.
EXPOR_DADOS_PESSOAIS=false
